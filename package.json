{
  "name": "store-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "api:dev": "tsx watch server/src/index.ts",
    "api:start": "tsx server/src/index.ts",
    "api:check": "tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"{src,server}/**/*.{ts,css}\" \"*.{html,json,yml}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,server}/**/*.{ts,css}\" \"*.{html,json,yml}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
